{
  "name": "steam-newsroom",
  "version": "0.9.1",
  "private": true,
  "description": "Steam library news, updates, and game history",
  "scripts": {
    "prepare": "starlight lsp",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node tests/run.cjs",
    "prebuild": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "build": "starlight pack",
    "inspect": "starlight inspect dist/steam-newsroom.star",
    "predev": "npm run prebuild",
    "dev": "starlight watch"
  },
  "devDependencies": {
    "@steambrew/starlight": "1.1.3",
    "@types/react": "19.1.1",
    "typescript": "5.9.3"
  },
  "author": "Leustad",
  "license": "MIT"
}